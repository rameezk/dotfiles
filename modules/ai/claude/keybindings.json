{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Scroll",
      "bindings": {
        "meta+up": "scroll:lineUp",
        "meta+down": "scroll:lineDown",
        "meta+shift+up": "scroll:pageUp",
        "meta+shift+down": "scroll:pageDown",
        "meta+g": "scroll:top",
        "meta+shift+g": "scroll:bottom"
      }
    }
  ]
}
